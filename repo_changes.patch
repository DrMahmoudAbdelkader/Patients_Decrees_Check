+# ---------------------------------------------------------------------
+# REVISION 3 (2026-09-21) -- evaluate_attention()
+# ---------------------------------------------------------------------
+# WHY THIS EXISTS
+#   The daily scan used to derive needs_attention from
+#   evaluate_dose_coverage() alone. That function returns False for ANY
+#   expired decree BEFORE it looks at the cutoff, so:
+#     * a decree with cutoff 0 (non-medical / supportive / pain) that had
+#       merely passed its expiry date was flagged, whatever its value;
+#     * a decree with its full value untouched was flagged just for being
+#       past its expiry date;
+#     * the flag never said WHICH of the two triggers fired.
+#   financial_review_scope (out_of_scope_*) was loaded but never used, and
+#   a non-medical decree was only ever protected by its cutoff being 0.
+#
+# THE RULE NOW (in order)
+#   1. unmapped (raw text not in the catalog / no plan)  -> flag
+#   2. not the 'current' decree of its plan              -> never flag
+#   3. exempt from the financial check                   -> never flag
+#        supportive | financial_review_scope != in_scope |
+#        service type is not Medication | cutoff is 0
+#      (exemption covers BOTH triggers -- value AND expiry)
+#   4. otherwise flag if any of: value unknown, no cutoff, value below
+#      one dose, decree expired -- and say which one in `reason`.
+#
+# An expired decree is still flagged (an expired medication decree does
+# need a human), but never silently: reason = 'expired' /
+# 'expired_and_insufficient' plus days_since_expiry, so staff can tell an
+# expiry-only flag (some decrees stay usable ~30 days past expiry) from a
+# genuine low-value flag.
+
+# Reasons that mean "no flag".
+ATTENTION_REASONS_OK = (
+    "ok", "non_current",
+    "exempt_supportive", "exempt_out_of_scope", "exempt_non_medication", "exempt_zero_cutoff",
+)
+
+
+def value_check_exemption(decree: Dict) -> Optional[str]:
+    """Reason string if this decree must never be flagged, else None."""
+    if decree.get("is_supportive"):
+        return "exempt_supportive"
+
+    scope = decree.get("financial_review_scope") or "in_scope"
+    if scope != "in_scope":
+        return "exempt_out_of_scope"
+
+    category = _normalize_catalog_category(decree.get("service_type")) or DEFAULT_CATALOG_CATEGORY
+    if category != "medication":
+        return "exempt_non_medication"
+
+    avg = decree.get("average_dose_value")
+    try:
+        cutoff_is_zero = avg is not None and float(avg) == 0.0
+    except (TypeError, ValueError):
+        cutoff_is_zero = False
+    # A depot+partner decree (Zoladex) derives its cutoff from history,
+    # so a 0 in the static column is never a "no floor" declaration there.
+    if cutoff_is_zero and not decree.get("depot_interval_months"):
+        return "exempt_zero_cutoff"
+
+    return None
+
+
+def _days_since(iso_date: Optional[str], as_of_iso: Optional[str]) -> Optional[int]:
+    if not iso_date:
+        return None
+    as_of_iso = as_of_iso or cairo_today_iso()
+    try:
+        return (datetime.strptime(as_of_iso, "%Y-%m-%d") - datetime.strptime(iso_date, "%Y-%m-%d")).days
+    except ValueError:
+        return None
+
+
+def _money(x) -> str:
+    try:
+        return f"{float(x):,.2f}"
+    except (TypeError, ValueError):
+        return str(x)
+
+
+def evaluate_attention(decree: Dict, real_value_left: Optional[float],
+                       as_of_iso: Optional[str] = None,
+                       value_left_history: Optional[List[Dict]] = None) -> Dict:
+    """Single source of truth for needs_attention. Returns
+        {needs_attention: bool, reason: str, detail: str|None,
+         days_since_expiry: int|None}
+    `reason` is one of ATTENTION_REASONS_OK (no flag) or:
+        unmapped | value_unknown | no_cutoff_value |
+        insufficient_value | expired | expired_and_insufficient
+    `detail` is a short Arabic sentence for the UI; only set for flags."""
+    regimen = decree.get("regimen_status")
+
+    exemption = value_check_exemption(decree)
+    if exemption:
+        return {"needs_attention": False, "reason": exemption, "detail": None, "days_since_expiry": None}
+
+    if regimen == "unmapped":
+        return {"needs_attention": True, "reason": "unmapped", "days_since_expiry": None,
+                "detail": "وصف القرار غير موجود في كتالوج القرارات (يحتاج إضافة/ربط)"}
+
+    if regimen != "current":
+        return {"needs_attention": False, "reason": "non_current", "detail": None, "days_since_expiry": None}
+
+    expired = is_decree_expired(decree.get("decree_expiry_date"), as_of_iso)
+    days_exp = _days_since(decree.get("decree_expiry_date"), as_of_iso) if expired else None
+
+    if real_value_left is None:
+        return {"needs_attention": True, "reason": "value_unknown", "days_since_expiry": days_exp,
+                "detail": "تعذر حساب المتبقي الفعلي (قيمة المتبقي من موقع SMC غير متاحة)"}
+
+    value_ok = evaluate_dose_coverage(decree, real_value_left, as_of_iso, value_left_history,
+                                      check_expiry=False)
+    if value_ok is None:
+        return {"needs_attention": True, "reason": "no_cutoff_value", "days_since_expiry": days_exp,
+                "detail": "لا توجد قيمة جرعة (Average_Dose_Value) لهذا القرار في الكتالوج"}
+
+    avg = decree.get("average_dose_value")
+    dose_txt = "" if (decree.get("depot_interval_months") or avg is None) else f" ({_money(avg)})"
+
+    if expired and not value_ok:
+        return {"needs_attention": True, "reason": "expired_and_insufficient", "days_since_expiry": days_exp,
+                "detail": f"القرار منتهي منذ {days_exp} يوم والمتبقي الفعلي {_money(real_value_left)} "
+                          f"أقل من قيمة الجرعة{dose_txt}"}
+    if expired:
+        return {"needs_attention": True, "reason": "expired", "days_since_expiry": days_exp,
+                "detail": f"القرار منتهي منذ {days_exp} يوم (تاريخ الانتهاء {decree.get('decree_expiry_date')}) "
+                          f"- المتبقي الفعلي {_money(real_value_left)} يكفي جرعة"}
+    if not value_ok:
+        return {"needs_attention": True, "reason": "insufficient_value", "days_since_expiry": None,
+                "detail": f"المتبقي الفعلي {_money(real_value_left)} أقل من قيمة الجرعة{dose_txt}"}
+
+    return {"needs_attention": False, "reason": "ok", "detail": None, "days_since_expiry": None}
